{{ ansible_managed | comment }}
# {{ pdns_zone_name }} zone file — generated by ansible/roles/pdns-zone from hosts.yml.
#
# Standard BIND zone file format. Contains:
#   - SOA record (start of authority)
#   - NS records (all custom nameservers)
#   - A records for ns1–ns13 (matching glue records at Namecheap + externalIPs in pdns-service-dns.yaml)
#
# ExternalDNS and cert-manager add dynamic records (A records for services,
# _acme-challenge TXT records for DNS-01) via RFC2136 updates to a journal
# file (ephemeral emptyDir). These dynamic records do not appear in this file —
# they live in the PowerDNS journal. On pod restart, ExternalDNS re-creates
# service records and cert-manager re-creates challenge records as needed.
#
# To regenerate after worker changes:
#   ansible-playbook ansible/playbooks/operations/update-pdns-zones.yml -e pdns_zone_name={{ pdns_zone_name }}
apiVersion: v1
kind: ConfigMap
metadata:
  name: pdns-zone-{{ pdns_zone_name | replace('.', '-') }}
  namespace: external-dns
data:
  {{ pdns_zone_name }}.zone: |
    $ORIGIN {{ pdns_zone_name }}.
    $TTL 300

    @   IN SOA {{ pdns_nameservers[0].prefix }}.{{ pdns_zone_name }}. hostmaster.{{ pdns_zone_name }}. (
            {{ ansible_facts['date_time']['epoch'] }} ; serial (regenerated on each run)
            10800      ; refresh (3 hours)
            3600       ; retry (1 hour)
            604800     ; expire (1 week)
            300        ; minimum (5 minutes)
        )

    ; NS records — all custom nameservers (matching Namecheap glue records)
{% for ns in pdns_nameservers %}
    @   IN NS  {{ ns.prefix }}.{{ pdns_zone_name }}.
{% endfor %}

    ; Glue records — nameserver IPs (must match Namecheap glue records + pdns-service-dns externalIPs)
{% for ns in pdns_nameservers %}
    {{ '%-5s' | format(ns.prefix) }}  IN A  {{ ns.ip }}
{% endfor %}