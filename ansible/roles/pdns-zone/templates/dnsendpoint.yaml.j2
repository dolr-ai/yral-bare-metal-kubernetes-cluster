{{ ansible_managed | comment }}
# DNSEndpoint resources for {{ pdns_zone_name }} — generated by ansible/roles/pdns-zone from hosts.yml.
#
# Source of truth: ansible/inventory/hosts.yml
#   - Workers with `namecheap_nameserver` annotation → NS records + glue A records
#   - All nodes (workers + control planes) → domain A records + wildcard
#
# Synced to PowerDNS by ExternalDNS via RFC2136 dynamic updates.
# The init container in pdns-statefulset.yaml creates the zone infrastructure
# (zone, SOA, TSIG key, metadata). All actual DNS records live here.
#
# To regenerate after node changes:
#   ansible-playbook ansible/playbooks/operations/update-pdns-zones.yml -e pdns_zone_name={{ pdns_zone_name }}
---
apiVersion: externaldns.k8s.io/v1alpha1
kind: DNSEndpoint
metadata:
  name: {{ pdns_zone_name | replace('.', '-') }}-ns
  namespace: external-dns
spec:
  endpoints:
    # NS records — all custom nameservers
    - dnsName: {{ pdns_zone_name }}
      recordTTL: 300
      recordType: NS
      targets:
{% for ns in pdns_nameservers %}
        - {{ ns.prefix }}.{{ pdns_zone_name }}
{% endfor %}
---
apiVersion: externaldns.k8s.io/v1alpha1
kind: DNSEndpoint
metadata:
  name: {{ pdns_zone_name | replace('.', '-') }}-nameserver-a
  namespace: external-dns
spec:
  endpoints:
    # Glue records — nameserver IPs (must match Namecheap glue records + pdns-service-dns externalIPs)
    # These IPs come from hosts.yml (workers with namecheap_nameserver annotation)
{% for ns in pdns_nameservers %}
    - dnsName: {{ ns.prefix }}.{{ pdns_zone_name }}
      recordTTL: 300
      recordType: A
      targets:
        - {{ ns.ip }}
{% endfor %}
---
apiVersion: externaldns.k8s.io/v1alpha1
kind: DNSEndpoint
metadata:
  name: {{ pdns_zone_name | replace('.', '-') }}-app-a
  namespace: external-dns
spec:
  endpoints:
    # {{ pdns_zone_name }} + wildcard → ALL node IPs (workers + control planes)
    # Any request hitting any node is routed by the Cilium mesh to the node
    # hosting the destination pod. No per-service routing.
    # Update by regenerating from hosts.yml after adding/removing nodes.
    - dnsName: {{ pdns_zone_name }}
      recordTTL: 300
      recordType: A
      targets:
{% for ip in pdns_all_node_ips %}
        - {{ ip }}
{% endfor %}
    - dnsName: "*.{{ pdns_zone_name }}"
      recordTTL: 300
      recordType: A
      targets:
{% for ip in pdns_all_node_ips %}
        - {{ ip }}
{% endfor %}