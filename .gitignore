.yral-infra-ed25519

# Generated .env (one-off from fnox export, e.g. yral-auth-image-run)
.env

# pitchfork local overrides (machine-specific)
pitchfork.local.toml

# Python venv managed by mise (tasks.bootstrap)
.venv/

# mise local overrides (secrets, machine-specific)
mise.local.toml

