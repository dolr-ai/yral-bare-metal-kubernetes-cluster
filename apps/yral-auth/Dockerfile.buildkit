# Multi-stage Dockerfile for building yral-auth from source (Shipwright/BuildKit).
# Follows the official Leptos SSR deployment guide:
# https://book.leptos.dev/deployment/ssr.html\#creating-a-containerfile
#
# Build context: apps/yral-auth/ (set by Shipwright spec.source.contextDir)

# ── Stage 1: Build ──────────────────────────────────────────────────────────
FROM rust:1.88-alpine AS builder

RUN apk update && \
    apk add --no-cache bash curl npm libc-dev binaryen git

# Install cargo-leptos via official installer
RUN curl --proto '=https' --tlsv1.3 -LsSf https://github.com/leptos-rs/cargo-leptos/releases/latest/download/cargo-leptos-installer.sh | sh

# Add the WASM target
RUN rustup target add wasm32-unknown-unknown

WORKDIR /app

# Copy only the files needed for the build (not target/, .env, etc.)
COPY Cargo.toml Cargo.lock ./
COPY src/ ./src/
COPY style/ ./style/
COPY public/ ./public/
COPY tailwind.config.js ./
COPY package.json pnpm-lock.yaml ./
COPY task_runner/ ./task_runner/

# Install JS dependencies (tailwindcss)
RUN npm install

# Build the app
RUN cargo leptos build --release -vv

# ── Stage 2: Runtime ───────────────────────────────────────────────────────
FROM rust:1.88-alpine AS runtime

WORKDIR /app

# Copy the server binary
COPY --from=builder /app/target/release/yral-auth /app/

# Copy the site assets (JS/WASM/CSS)
COPY --from=builder /app/target/site /app/site

# Set required env variables
ENV RUST_LOG="info"
ENV LEPTOS_OUTPUT_NAME="yral-auth"
ENV LEPTOS_SITE_ROOT="site"
ENV LEPTOS_SITE_PKG_DIR="pkg"
ENV LEPTOS_SITE_ADDR="0.0.0.0:8080"
ENV LEPTOS_ENV="PROD"
ENV LEPTOS_HASH_FILES="true"
ENV APP_ENV="production"

EXPOSE 8080

CMD ["/app/yral-auth"]
