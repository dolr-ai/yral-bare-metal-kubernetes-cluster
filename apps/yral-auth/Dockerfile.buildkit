# Multi-stage Dockerfile for building yral-auth from source in-cluster (Shipwright/BuildKit).
#
# Uses Alpine as the builder so musl is the NATIVE toolchain — this produces
# truly static binaries that run on scratch. No cross-compilation needed.
#
# Build context: apps/yral-auth/ (set by Shipwright spec.source.contextDir)

# ── Stage 1: Build ──────────────────────────────────────────────────────────
FROM rust:1.88-alpine AS builder

# Install build dependencies
RUN apk add --no-cache \
    musl-dev \
    pkgconfig \
    openssl-dev \
    openssl-libs-static \
    nodejs \
    npm \
    git \
    curl

# Install cargo-binstall + cargo-leptos
RUN curl -L https://github.com/cargo-bins/cargo-binstall/releases/latest/download/cargo-binstall-x86_64-unknown-linux-musl.tgz -o /tmp/cargo-binstall.tgz && \
    tar -xzf /tmp/cargo-binstall.tgz -C /usr/local/bin && \
    chmod +x /usr/local/bin/cargo-binstall && \
    rm /tmp/cargo-binstall.tgz && \
    cargo binstall cargo-leptos --version 0.3.2 --no-confirm

# Add wasm target (musl is already the default on Alpine)
RUN rustup target add wasm32-unknown-unknown

WORKDIR /app

# Copy Cargo.toml + Cargo.lock first for better layer caching
COPY Cargo.toml Cargo.lock ./

# Copy the source code
COPY src/ ./src/
COPY style/ ./style/
COPY public/ ./public/
COPY tailwind.config.js ./
COPY package.json ./
COPY rust-toolchain.toml ./
COPY task_runner/ ./task_runner/

# Install JS dependencies (tailwindcss)
# TODO: Revert to the default npm registry
RUN npm install --registry https://registry.npmmirror.com

# Set Leptos environment variables for the build
ENV LEPTOS_OUTPUT_NAME="yral-auth"
ENV LEPTOS_SITE_ROOT="target/site"
ENV LEPTOS_SITE_PKG_DIR="pkg"
ENV LEPTOS_SITE_ADDR="0.0.0.0:8080"
ENV LEPTOS_ENV="PROD"
ENV LEPTOS_HASH_FILES="true"
ENV LEPTOS_TAILWIND_VERSION="v4.0.15"

# Build the app — on Alpine, the default target IS x86_64-unknown-linux-musl
# so the binary is natively static. No LEPTOS_BIN_TARGET_TRIPLE needed.
RUN cargo leptos build --release --lib-features release-lib --bin-features release-bin

# ── Stage 2: Runtime (scratch — musl binary is fully static on Alpine) ────
FROM scratch

WORKDIR /app

# Copy the built binary
COPY --from=builder /app/target/release/yral-auth .
COPY --from=builder /app/target/release/hash.txt .

# Copy the Leptos site assets (WASM, JS, CSS)
COPY --from=builder /app/target/site ./site

# Copy CA certificates (app makes HTTPS calls to Google, Apple, WhatsApp, etc.)
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt

# Set Leptos environment variables (runtime config baked into image)
ENV LEPTOS_OUTPUT_NAME="yral-auth"
ENV LEPTOS_SITE_ROOT="site"
ENV LEPTOS_SITE_PKG_DIR="pkg"
ENV LEPTOS_SITE_ADDR="0.0.0.0:8080"
ENV LEPTOS_ENV="PROD"
ENV LEPTOS_HASH_FILES="true"
ENV APP_ENV="production"

EXPOSE 8080

ENTRYPOINT ["/app/yral-auth"]
