# Multi-stage Dockerfile for building yral-auth from source (Shipwright/BuildKit).
# Build context: apps/yral-auth/ (set by Shipwright spec.source.contextDir)

# ── Stage 1: Build ──────────────────────────────────────────────────────────
FROM rust:latest AS builder

# Install build dependencies (git needed for CARGO_NET_GIT_FETCH_WITH_CLI)
RUN apt-get update && apt-get install -y --no-install-recommends musl-tools git && \
    rm -rf /var/lib/apt/lists/*

# Install mise (for Node.js — needed by tailwindcss via cargo-leptos)
ENV MISE_DATA_DIR="/mise"
ENV MISE_CONFIG_DIR="/mise"
ENV MISE_CACHE_DIR="/mise/cache"
ENV MISE_INSTALL_PATH="/usr/local/bin/mise"
ENV PATH="/mise/shims:$PATH"
RUN curl https://mise.run | sh

# Add musl target + wasm target
RUN rustup target add x86_64-unknown-linux-musl wasm32-unknown-unknown

# Install cargo-binstall + cargo-leptos
RUN curl -L https://github.com/cargo-bins/cargo-binstall/releases/latest/download/cargo-binstall-x86_64-unknown-linux-musl.tgz -o /tmp/cargo-binstall.tgz && \
    tar -xzf /tmp/cargo-binstall.tgz -C /usr/local/bin && \
    chmod +x /usr/local/bin/cargo-binstall && \
    rm /tmp/cargo-binstall.tgz && \
    cargo binstall cargo-leptos --version 0.3.2 --no-confirm

WORKDIR /app

# Copy mise.toml + Cargo.toml + Cargo.lock first for better layer caching
COPY mise.toml Cargo.toml Cargo.lock ./

# Install Node.js via mise (pinned in mise.toml)
RUN mise trust -a && mise install

# Copy the source code
COPY src/ ./src/
COPY style/ ./style/
COPY public/ ./public/
COPY tailwind.config.js ./
COPY package.json ./
COPY .cargo/ ./.cargo/
COPY rust-toolchain.toml ./

# Install JS dependencies (tailwindcss)
RUN npm install

# Set Leptos environment variables for the build
ENV LEPTOS_OUTPUT_NAME="yral-auth"
ENV LEPTOS_SITE_ROOT="target/site"
ENV LEPTOS_SITE_PKG_DIR="pkg"
ENV LEPTOS_SITE_ADDR="0.0.0.0:8080"
ENV LEPTOS_ENV="PROD"
ENV LEPTOS_TAILWIND_VERSION="v4.0.15"
ENV LEPTOS_BIN_TARGET_TRIPLE="x86_64-unknown-linux-musl"

# Use git CLI for fetching git deps (libgit2 has SSL issues with large repos like dfinity/ic)
ENV CARGO_NET_GIT_FETCH_WITH_CLI=true

# Build the app
RUN cargo leptos build --release --lib-features release-lib --bin-features release-bin

# ── Stage 2: Runtime (scratch) ─────────────────────────────────────────────
FROM scratch

WORKDIR /app

# Copy the built binary
COPY --from=builder /app/target/x86_64-unknown-linux-musl/release/yral-auth .

# Copy the Leptos site assets (WASM, JS, CSS)
COPY --from=builder /app/target/site ./site

# Copy CA certificates (app makes HTTPS calls to Google, Apple, WhatsApp, etc.)
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt

# Set Leptos environment variables (runtime config baked into image)
ENV LEPTOS_OUTPUT_NAME="yral-auth"
ENV LEPTOS_SITE_ROOT="site"
ENV LEPTOS_SITE_PKG_DIR="pkg"
ENV LEPTOS_SITE_ADDR="0.0.0.0:8080"
ENV LEPTOS_ENV="PROD"
ENV APP_ENV="production"

EXPOSE 8080

ENTRYPOINT ["/app/yral-auth"]
