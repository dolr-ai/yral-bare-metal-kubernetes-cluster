# Dockerfile for my-website (Leptos SSR app → native Rust binary).
#
# Multi-stage build:
#   Stage 1: Rust builder — cargo leptos build (musl binary + WASM client)
#   Stage 2: scratch runtime — just the binary + static assets + CA certs
#
# Build context: repo root (set by Shipwright spec.source — no contextDir).
# .dockerignore excludes target/, node_modules/, .git/, ansible/, kubernetes/.
# cargo-leptos manages Tailwind CSS internally via the tailwind CLI — no Node.js needed.

# ── Stage 1: Build ──────────────────────────────────────────────────────────
FROM docker.io/rust:1.90-bookworm AS builder

# Install build dependencies (musl-tools for musl cross-compilation)
RUN apt-get update && apt-get install -y --no-install-recommends \
    musl-tools \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Install cargo-binstall + cargo-leptos
RUN curl -L https://github.com/cargo-bins/cargo-binstall/releases/latest/download/cargo-binstall-x86_64-unknown-linux-musl.tgz -o /tmp/cargo-binstall.tgz && \
    tar -xzf /tmp/cargo-binstall.tgz -C /usr/local/bin && \
    chmod +x /usr/local/bin/cargo-binstall && \
    rm /tmp/cargo-binstall.tgz && \
    cargo binstall cargo-leptos --no-confirm

WORKDIR /app

# Copy the entire monorepo workspace (root Cargo.toml + all apps/).
# .dockerignore excludes target/, node_modules/, .git/, ansible/, kubernetes/.
COPY . .

# Set Leptos environment variables for the build
ENV LEPTOS_OUTPUT_NAME="my-website"
ENV LEPTOS_SITE_ROOT="target/site"
ENV LEPTOS_SITE_PKG_DIR="pkg"
ENV LEPTOS_SITE_ADDR="0.0.0.0:8080"
ENV LEPTOS_ENV="PROD"
ENV LEPTOS_BIN_TARGET_TRIPLE="x86_64-unknown-linux-musl"

# Build the app (cargo-leptos runs from apps/my-website/ — same as the mise task)
RUN cd apps/my-website && cargo leptos build --release

# ── Stage 2: Runtime (scratch) ─────────────────────────────────────────────
FROM scratch

WORKDIR /app

# Copy the built binary (cargo-leptos uses the workspace root target dir)
COPY --from=builder /app/target/x86_64-unknown-linux-musl/release/my-website .

# Copy the Leptos site assets (WASM, JS, CSS)
COPY --from=builder /app/target/site ./site

# Copy CA certificates
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt

# Set Leptos environment variables (runtime config baked into image)
ENV LEPTOS_OUTPUT_NAME="my-website"
ENV LEPTOS_SITE_ROOT="site"
ENV LEPTOS_SITE_PKG_DIR="pkg"
ENV LEPTOS_SITE_ADDR="0.0.0.0:8080"
ENV LEPTOS_ENV="PROD"

EXPOSE 8080

ENTRYPOINT ["/app/my-website"]