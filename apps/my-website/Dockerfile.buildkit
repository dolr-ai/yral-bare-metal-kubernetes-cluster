# Dockerfile for my-website (Leptos SSR app → native Rust binary).
#
# Multi-stage build:
#   Stage 1: Rust builder — cargo leptos build (musl binary + WASM client)
#   Stage 2: Serve with a minimal runtime image containing the binary + static assets
#
# Build context: repo root (needed for monorepo structure + workspace dependencies).
# BuildKit strategy: rootless BuildKit via Shipwright ClusterBuildStrategy.

# --- Stage 1: Build Rust binary + WASM client ---
FROM docker.io/rust:1.90-bookworm AS builder

# Install build dependencies
RUN apt-get update && apt-get install -y \
    cmake \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Rust targets and cargo-leptos
# cargo-leptos automatically downloads and manages the Tailwind CLI — no Node.js needed
RUN rustup target add x86_64-unknown-linux-musl wasm32-unknown-unknown
RUN cargo binstall cargo-leptos --no-confirm

WORKDIR /app

# Copy workspace manifest first for layer caching
COPY Cargo.toml Cargo.lock ./
COPY apps/my-website/Cargo.toml apps/my-website/Cargo.toml

# Create a dummy src so cargo can resolve the workspace
RUN mkdir -p apps/my-website/src && echo 'fn main() {}' > apps/my-website/src/main.rs

# Pre-build dependencies (layer cache)
RUN cargo build --release -p my-website 2>/dev/null || true

# Copy the full source
COPY apps/my-website/ apps/my-website/

# Build the Leptos app (release musl binary + WASM client)
# cargo-leptos compiles Tailwind CSS via the tailwind CLI (no npm install needed)
RUN cd apps/my-website && \
    LEPTOS_BIN_TARGET_TRIPLE=x86_64-unknown-linux-musl \
    cargo leptos build --release

# --- Stage 2: Serve ---
FROM docker.io/alpine:latest

# Install ca-certificates for HTTPS and libgcc for the musl binary
RUN apk add --no-cache ca-certificates libgcc

WORKDIR /app

# Copy the built binary
COPY --from=builder /app/target/x86_64-unknown-linux-musl/release/my-website /app/my-website

# Copy the site assets (static files, WASM, CSS)
COPY --from=builder /app/apps/my-website/target/site /app/site

ENV LEPTOS_SITE_ROOT=/app/site
ENV LEPTOS_SITE_ADDR=0.0.0.0:8080

EXPOSE 8080

CMD ["/app/my-website"]