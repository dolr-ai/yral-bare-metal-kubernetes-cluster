{
    # Global options
    email joel@gobazzinga.io

    # Enable HTTP/2 and HTTP/3
    servers {
        protocols h1 h2
    }
}

# off-chain-agent REST API (plain HTTP reverse proxy)
# Replace YOUR_DOMAIN with actual domain (e.g., offchain.yral.com)
offchain.yral.com {
    reverse_proxy offchain-agent:50051 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    # Security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # Logging
    log {
        output stdout
        format json
        level INFO
    }
}

# Health check endpoint on HTTP (for load balancer health checks)
:80 {
    respond /health "OK" 200
    respond "Service available at https://offchain.yral.com" 200
}
