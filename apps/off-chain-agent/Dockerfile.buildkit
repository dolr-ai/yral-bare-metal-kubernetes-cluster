# Multi-stage Dockerfile for building off-chain-agent from source (Shipwright/BuildKit).
# Build context: repo root (set by Shipwright spec.source.contextDir: ".")
# Static musl binary — all TLS via rustls (no openssl/native-tls).
FROM rust:latest AS builder
RUN apt-get update && apt-get install -y --no-install-recommends musl-tools && rm -rf /var/lib/apt/lists/*
WORKDIR /app

# Copy the entire monorepo workspace
COPY . .

# Build the off-chain-agent binary
RUN cargo build --release --target x86_64-unknown-linux-musl -p off-chain-agent

FROM scratch
WORKDIR /app
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=builder /app/target/x86_64-unknown-linux-musl/release/icp-off-chain-agent .
EXPOSE 50051
CMD ["./icp-off-chain-agent"]