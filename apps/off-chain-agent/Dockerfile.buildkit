# Multi-stage Dockerfile for building off-chain-agent from source (Shipwright/BuildKit).
# Static musl binary — all TLS via rustls (no openssl/native-tls).
FROM rust:latest AS builder
RUN apt-get update && apt-get install -y --no-install-recommends musl-tools protobuf-compiler && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY . .
RUN cargo build --release --target x86_64-unknown-linux-musl
FROM scratch
WORKDIR /app
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=builder /app/target/x86_64-unknown-linux-musl/release/icp-off-chain-agent .
EXPOSE 50051
CMD ["./icp-off-chain-agent"]