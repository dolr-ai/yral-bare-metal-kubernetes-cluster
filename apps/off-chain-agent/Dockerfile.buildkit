# Multi-stage Dockerfile for building off-chain-agent from source (Shipwright/BuildKit).
FROM rust:latest AS builder
RUN apt-get update && apt-get install -y --no-install-recommends musl-tools protobuf-compiler libssl-dev pkg-config && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY . .
RUN cargo build --release
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates libssl3 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder /app/target/release/icp-off-chain-agent .
EXPOSE 50051
CMD ["./icp-off-chain-agent"]