// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/ubuntu
{
	"name": "Ubuntu",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/python:3",
	"features": {
		"ghcr.io/devcontainers-extra/features/ansible:2": {
			"inject_python_packages": "ansible-lint yamllint"
		},
		"ghcr.io/devcontainers/features/github-cli:1": {}
	},
	// Mount SSH agent socket from WSL host into container
	"mounts": [
		"type=bind,source=${env:HOME}/.ssh/agent.sock,target=/ssh-agent,consistency=cached",
		"type=bind,source=${env:HOME}/.config/gh,target=/home/vscode/.config/gh,consistency=cached"
	],
	// Set SSH_AUTH_SOCK environment variable to point to mounted socket
	"remoteEnv": {
		"SSH_AUTH_SOCK": "/ssh-agent"
	},
	// Run post-create setup script
	"postCreateCommand": ".devcontainer/postCreate.sh"
	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],
	// Configure tool-specific properties.
	// "customizations": {},
	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}