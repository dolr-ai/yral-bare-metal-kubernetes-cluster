// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/ubuntu
{
	"name": "Ubuntu",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/base:ubuntu",
	"features": {
		"ghcr.io/devcontainers/features/python:1": {
			"installTools": true,
			"version": "3.14"
		},
		"ghcr.io/devcontainers-extra/features/ansible:2": {},
		"ghcr.io/devcontainers/features/github-cli:1": {},
		"ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {},
		"ghcr.io/goldsam/dev-container-features/flux2:1": {},
		"ghcr.io/devcontainers-extra/features/age:1": {},
		"ghcr.io/devcontainers-extra/features/sops:1": {},
		// "ghcr.io/devcontainers/features/aws-cli:1": {},
		"ghcr.io/devcontainers-extra/features/ripgrep:1": {},
		"ghcr.io/devcontainers/features/rust:1": {},
		"ghcr.io/devcontainers-extra/features/direnv:1": {},
	},
	// Make host.docker.internal resolve to the host machine (for Ollama, etc.)
	"runArgs": [
		"--add-host=host.docker.internal:host-gateway"
	],
	// Use Docker Desktop's built-in SSH agent socket on macOS
	"mounts": [
		"type=bind,source=/run/host-services/ssh-auth.sock,target=/ssh-agent",
		"type=bind,source=${env:HOME}/.config/gh,target=/home/vscode/.config/gh,consistency=cached"
	],
	// Run post-create setup script
	"postCreateCommand": ".devcontainer/post-create.sh",
	"customizations": {
		"vscode": {
			"extensions": [
				"Anthropic.claude-code"
			]
		}
	}
	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],
	// Configure tool-specific properties.
	// "customizations": {},
	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}